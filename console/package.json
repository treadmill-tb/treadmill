{
  "name": "treadmill-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "codegen": "openapi-typescript ../switchboard/api-spec/openapi.yaml -o app/api/schema.d.ts && json2ts -i ../treadmill-rs/protocol-schema/host_spec_latest.schema.json -o app/api/host-spec.d.ts --unknownAny",
    "dev": "react-router dev",
    "build": "react-router build",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint ."
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/nats-core": "^3.4.0",
    "@picocss/pico": "^2.1.1",
    "@react-router/node": "^8.3.0",
    "@tanstack/react-query": "^5.90.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "isbot": "^5",
    "lucide-react": "^1.47.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.3.0",
    "react-zoom-pan-pinch": "^4.2.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "openapi-typescript": "^7.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^8.0.0",
    "vite-plugin-svgr": "^5.2.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
