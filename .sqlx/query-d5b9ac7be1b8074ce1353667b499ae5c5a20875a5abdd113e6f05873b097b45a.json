{
  "db_name": "PostgreSQL",
  "query": "update tml_switchboard.jobs\n                   set terminate_requested_at = coalesce(terminate_requested_at, $2),\n                       terminate_requested_reason = coalesce(terminate_requested_reason, $3)\n                   where job_id = $1",
